# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Default SQLite database for instant local development
DATABASE_URL="file:./dev.db"

# For Vercel Production (PostgreSQL with Neon.tech / Supabase.com), update provider in schema.prisma to "postgresql"
# and use:
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Base URL of your deployed app or local server for pixel generation links
NEXT_PUBLIC_APP_URL="http://localhost:3000"
